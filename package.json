{
  "name": "wdc-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Kaduna State WDC Digital Reporting Platform — backend",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0 <21.0.0 || >=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint \"{src,tests,scripts}/**/*.ts\" --max-warnings=0",
    "lint:fix": "eslint \"{src,tests,scripts}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "openapi:generate": "tsx scripts/openapi-generate.ts",
    "openapi:check": "tsx scripts/openapi-check.ts",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:migrate": "tsx scripts/migrate.ts",
    "drizzle:studio": "drizzle-kit studio",
    "seed": "tsx scripts/seed.ts",
    "seed:users": "tsx scripts/seed-users.ts",
    "gen:jwt-keys": "tsx scripts/gen-jwt-keys.ts",
    "migrate:mvp": "tsx scripts/migrate_mvp.ts",
    "verify:migration": "tsx scripts/verify_migration.ts",
    "flag:migration": "tsx scripts/flag_migration_issues.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm openapi:check"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1038.0",
    "@aws-sdk/s3-request-presigner": "^3.1038.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/swagger": "^8.0.0",
    "@nestjs/terminus": "^10.2.3",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.216.0",
    "@opentelemetry/instrumentation": "^0.216.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.216.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "argon2": "^0.41.1",
    "bullmq": "^5.76.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "drizzle-orm": "^0.36.0",
    "ioredis": "^5.4.1",
    "nestjs-pino": "^4.1.0",
    "otplib": "^12.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^11.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.2.0",
    "@nestjs/testing": "^10.4.0",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.17.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "@vitest/coverage-v8": "^2.1.4",
    "drizzle-kit": "^0.28.0",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "fast-check": "^3.23.1",
    "pino-pretty": "^11.3.0",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "yaml": "^2.6.0"
  },
  "pnpm": {
    "overrides": {
      "drizzle-orm": "^0.45.2",
      "glob": "^10.5.0",
      "multer": "^2.1.1",
      "picomatch": "^4.0.4",
      "lodash": "^4.18.0"
    }
  }
}
