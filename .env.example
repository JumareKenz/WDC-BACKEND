# Copy to .env.local for local dev. Never commit a populated .env file.

# --- Runtime ---
NODE_ENV=development
# Default 3100 (not 3000) to avoid clashing with common dev frontends.
PORT=3100
LOG_LEVEL=debug

# --- Database (matches docker-compose) ---
# Use 127.0.0.1 (not localhost) to force IPv4 — avoids WSL/Hyper-V IPv6 quirks
# that surface as spurious ECONNRESETs against Docker-mapped ports on Windows.
DATABASE_URL=postgres://wdc:wdc@127.0.0.1:5433/wdc
DATABASE_REPLICA_URL=postgres://wdc_ro:wdc_ro@127.0.0.1:5433/wdc

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6380

# --- Object storage (MinIO in dev) ---
S3_ENDPOINT=http://127.0.0.1:9100
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=wdc-artefacts
S3_FORCE_PATH_STYLE=true

# --- Auth ---
JWT_PRIVATE_KEY_PATH=./secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt-public.pem
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
ARGON2_PEPPER=change-me-in-prod-32-bytes-minimum-xxxxx
TOTP_ISSUER="WDC Kaduna"
# Per-deployment data-encryption key for pgcrypto column encryption (PII,
# TOTP secrets). Dev only — production reads from Vault per RUNBOOK §4.
KMS_DEK=change-me-in-prod-32-bytes-minimum-xxxxx-pii

# --- AI / RAG (M12+) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
EMBEDDING_MODEL=text-embedding-3-small
ASR_PROVIDER=local-whisper

# --- Notifications (M10+) ---
POSTMARK_TOKEN=
TERMII_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- Reports / sealing ---
REPORT_SEAL_GRACE_DAYS=7

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=wdc-backend
PROMETHEUS_PORT=9464
